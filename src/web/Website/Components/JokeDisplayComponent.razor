@if (myJoke != null)
{
    <div class="joke-wrapper">
        <div class="JokeCard">
            <AuthorizeView Roles="Admin">
                <Authorized>
                    <a href="/jokeeditor?jokeId=@myJoke.JokeId" class="joke-edit-link" title="Edit this joke">Edit</a>
                </Authorized>
            </AuthorizeView>
            <div class="JokeCategory">
                @myJoke.Categories
            </div>
            <div class="JokeText">
                @((MarkupString)myFullText)
            </div>
        </div>
        @if (!string.IsNullOrEmpty(myFullText))
        {
            <div class="joke-rating">
                <MudRating SelectedValue="@displayRatingValue" MaxValue="5" Color="Color.Primary"
                           SelectedValueChanged="OnRatingChanged" />
                @if (ratingSubmitting)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Saving...</MudText>
                }
            </div>
        }
    </div>
}
