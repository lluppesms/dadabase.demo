@page "/admin"
@attribute [Authorize]
<PageTitle>Admin</PageTitle>

<div class="container" style="padding: 25px;">
    <div class="card mb-4">
        <div class="card-body">
            <h1>Admin Menu</h1>
            <p>You are logged in as: @userName</p>
            <p>In Admin Role: @isInAdminRole</p>

            <AuthorizeView Roles="Admin">
                <h4 class="mt-4 mb-3">Admin Tools</h4>
                <div class="d-flex flex-wrap gap-3 mb-4">
                    <a href="JokeEditor" class="btn btn-primary">
                        <i class="fas fa-edit me-2"></i>Joke Editor
                    </a>
                    <a href="Export" class="btn btn-primary">
                        <i class="fas fa-download me-2"></i>Export Data
                    </a>
                    <a href="swagger" class="btn btn-primary" target="_blank">
                        <i class="fas fa-code me-2"></i>Swagger API
                    </a>
                </div>

                <h4 class="mt-4 mb-3">System Information</h4>
                <ul>
                    <li>Data Source: @dataSource</li>
                    @* <li><span class="build-number" title="@FormatBuildDate(buildInfo.BuildDate)">@buildInfo.BuildNumber</span></li> *@
                    <li>API Key: @apiKeyInfo</li>
                    <li>AI Chat: @aiChatInfo</li>
                    <li>AI Image: @aiImageInfo</li>
                </ul>

                <h4 class="mt-4 mb-3">Data Source Test</h4>
                <div class="mb-3">
                    <button class="btn btn-secondary" @onclick="RunDataSourceTestAsync" disabled="@dataTestRunning">
                        <i class="fas fa-database me-2"></i>@(dataTestRunning ? "Testing..." : "Test Data Source")
                    </button>
                </div>
                @if (dataTestRunning)
                {
                    <div class="alert alert-info" role="status">Retrieving a random joke from the data source...</div>
                }
                else if (dataTestSucceeded)
                {
                    <div class="alert alert-success" role="status">
                        <strong>Data source is working.</strong>
                        <div>@dataTestMessage</div>
                    </div>
                }
                else if (!string.IsNullOrEmpty(dataTestError))
                {
                    <div class="alert alert-danger" role="alert">
                        <strong>Data source test failed.</strong>
                        <pre class="mb-0" style="white-space: pre-wrap;">@dataTestError</pre>
                    </div>
                }
            </AuthorizeView>
        </div>
    </div>
</div>
