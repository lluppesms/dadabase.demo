<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DadABase.BackupWebJob</RootNamespace>
    <AssemblyName>DadABase.BackupWebJob</AssemblyName>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <!-- Triggered WebJob metadata - Azure App Service discovers the job from App_Data/jobs/triggered/BackupExportJob -->
    <WebJobName>BackupExportJob</WebJobName>
    <IsWebJobProject>true</IsWebJobProject>
    <WebJobType>Triggered</WebJobType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.ApplicationInsights" Version="2.23.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Data\DadABase.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="settings.job">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="run.sh">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
